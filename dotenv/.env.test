
# ---------------------------------
# NestJS 애플리케이션 설정
# ---------------------------------
NODE_ENV=development
PORT=3000 # NestJS 앱이 실행될 포트

# ---------------------------------
# 1. 개발용 데이터베이스 (mysql-dev)
# ---------------------------------
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306 # docker-compose.yml의 '3306:3306'
DB_USERNAME=test
DB_PASSWORD=admin
DB_DATABASE=coupang_dev

# ---------------------------------
# 3. Redis (local-redis)
# ---------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379 # docker-compose.yml의 '6379:6379'
# REDIS_PASSWORD= (Redis에 비밀번호를 설정한 경우)

# ---------------------------------
# JWT (JSON Web Token) 설정
# ---------------------------------
# ⭐️ 보안: 아래 값들은 예시이며, 실제로는 복잡한 임의의 문자열로 변경해야 합니다.
# (터미널에서 'openssl rand -base64 32' 명령어로 생성 가능)
JWT_ACCESS_SECRET=FD17D51C1F1B2462DA5BD8256E985
JWT_ACCESS_EXPIRATION=1h # (액세스 토큰 만료 시간: 1시간)

JWT_REFRESH_SECRET=E722F6E2F495EB4D46E453EBD1E7F
JWT_REFRESH_EXPIRATION=7d # (리프레시 토큰 만료 시간: 7일)